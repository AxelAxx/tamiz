{
  "name": "tamiz",
  "version": "0.1.0",
  "private": true,
  "description": "Tamiz - Privacy-aware LLM gateway (monorepo root)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "arch": "depcruise apps/gateway/src apps/mcp-server/src --config .dependency-cruiser.cjs --output-type err",
    "test": "turbo run build && vitest run",
    "test:packages": "turbo run test",
    "evals": "turbo run build --filter=@tamiz/evals... && node packages/evals/dist/cli.js",
    "evals:readme": "turbo run build --filter=@tamiz/evals... && node packages/evals/dist/readme-cli.js",
    "build": "turbo run build",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "husky": "^9.1.7",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3",
    "vitest": "catalog:"
  }
}
