{
  "name": "@tamiz/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Tamiz gateway: privacy-aware, OpenAI-compatible LLM routing service (Hono, Node.js 22)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "generate-api-key": "tsx scripts/generate-api-key.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "api-key:add": "tsx scripts/add-api-key.ts"
  },
  "devDependencies": {
    "@tamiz/test-utils": "workspace:*",
    "@tamiz/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "drizzle-kit": "^0.31.11",
    "fast-check": "catalog:",
    "msw": "^2.15.0",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.136",
    "@ai-sdk/mistral": "^3.0.78",
    "@ai-sdk/openai": "^3.0.135",
    "@ai-sdk/openai-compatible": "^2.0.88",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@tamiz/contracts": "workspace:*",
    "ai": "^6.0.319",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0",
    "postgres": "^4.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
