# Tamiz dashboard configuration (spec 008 data-model §3.3). Validated at start: any
# missing or malformed value stops the dashboard with every problem listed.
# Copy to .env.local for `pnpm --filter @tamiz/dashboard dev`.

# The gateway's base URL (http or https).
TAMIZ_GATEWAY_URL=http://localhost:3000

# An admin API key of the gateway, for client `dashboard`. It never leaves the dashboard's
# server. Create one with `pnpm --filter @tamiz/gateway generate-api-key dashboard`
# (then add its entry to the gateway's TAMIZ_ADMIN_API_KEYS) or `api-key:add dashboard --admin`.
TAMIZ_DASHBOARD_ADMIN_KEY=

# scrypt hash of the operator passphrase: scrypt$<N>$<r>$<p>$<salt b64>$<hash b64>.
# Print one with `pnpm --filter @tamiz/dashboard hash-passphrase` (reads standard input).
# Note: in a .env file, `$` may need escaping (\$) depending on the loader.
TAMIZ_DASHBOARD_PASSPHRASE_HASH=

# Signs the session cookie; at least 32 bytes, e.g. `openssl rand -base64 48`.
TAMIZ_DASHBOARD_SESSION_SECRET=

# Where operators open the dashboard; its origin is the only one allowed to write.
TAMIZ_DASHBOARD_PUBLIC_URL=http://localhost:3100

# Folder of eval report files (CI artifact `evals-report`). Default ./data/evals.
# TAMIZ_DASHBOARD_EVALS_DIR=./data/evals

# true only behind a reverse proxy you control: the sign-in rate limit then counts by the
# first X-Forwarded-For hop. Otherwise every attempt shares one limit. Default false.
# TAMIZ_DASHBOARD_TRUST_PROXY=false
